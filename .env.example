# Resend (https://resend.com) — used by /api/contact to email the contact
# form to info@klikking.hu. Verify the klikking.hu sending domain in Resend
# before setting CONTACT_FROM_EMAIL to an @klikking.hu address.
RESEND_API_KEY=

# Optional overrides (defaults shown)
# CONTACT_TO_EMAIL=info@klikking.hu
# CONTACT_FROM_EMAIL=Klikking website <onboarding@resend.dev>
